const ll inf = 1e18;

struct EKflow {
    using flow_type = ll;
    int n;
    vector<vector<int>> graf;
    vector<vector<flow_type>> capacity;
    void init(int nn) {
        n = nn;
        graf.clear();
        capacity.clear();
        graf.resize(n);
        capacity.resize(n);
        for(int i = 0; i < n; i++)
            capacity[i].resize(n);
        return ;
    }

    void add_edge(int u, int v, flow_type cap) {
        capacity[u][v] = cap;
        graf[u].pb(v);
        graf[v].pb(u);
        return ;
    }

    flow_type augment(int s, int t, vector<int> &pr) {
        fill(all(pr), -1);
        pr[s] = -2;
        queue<pair<int, flow_type>> q;
        q.push(make_pair(s, inf));
        while(!q.empty()) {
            auto cur = q.front();
            q.pop();
            int v = cur.first;
            flow_type flow = cur.second;
            for(int u : graf[v]) {
                if(pr[u] == -1 && capacity[v][u]) {
                    pr[u] = v;
                    if(u == t) {
                        return min(flow, capacity[v][u]);
                    }
                    q.push({u, min(flow, capacity[v][u])});
                }
            }
        }
        return 0;
    }

    flow_type max_flow(int s, int t) {
        flow_type ans = 0;
        vector<int> pr(n);
        flow_type delta;
        while((delta = augment(s, t, pr))) {
            ans += delta;
            int cur = t;
            while(cur != s) {
                int p = pr[cur];
                capacity[p][cur] -= delta;
                capacity[cur][p] += delta;
                cur = p;
            }
        }
        return ans;
    }
};
