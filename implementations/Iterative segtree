struct SegTree {
    struct node {
        int mx;
        bool operator ==(const node &b) const {
            return (mx == b.mx);
        }
    };
    int n;
    vector<node> tree;
    node _0;

    void init(int n_) {
        n = n_;
        tree.clear();
        tree.resize(2 * n, _0);
        _0.mx = 0;
    }

    node createnode(const int &x) {
        node c;
        c.mx = x;
        return c;
    }

    node mymerge(node a, node b) {
        if(a == _0)
            return b;
        if(b == _0)
            return a;
        node c;
        c.mx = max(a.mx, b.mx);
        return c;
    }

    void upd(int ind, int val) {
        ind += n;
        tree[ind] = createnode(val);
        while(ind > 1) {
            ind >>= 1;
            tree[ind] = mymerge(tree[ind << 1], tree[ind << 1 | 1]);
        }
    }

    int query(int l, int r) {
        node res = _0;
        r++;
        l += n;
        r += n;
        while(l < r) {
            if(l & 1)
                res = mymerge(tree[l++], res);
            if(r & 1)
                res = mymerge(tree[--r], res);
            l >>= 1;
            r >>= 1;
        }
        return res.mx;
    }
};
