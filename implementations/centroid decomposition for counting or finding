
int sz[nmax];
vector<array<int, 2>> graf[nmax];
int target;
bool ban[nmax];
int ans = nmax;

void dfs_sz(int v, int pr) {
    sz[v] = 1;
    for(auto e : graf[v]) {
        int u = e[0];
        if(!ban[u] && u != pr) {
            dfs_sz(u, v);
            sz[v] += sz[u];
        }
    }
    return ;
}

int csz;

int find_centroid(int v, int pr) {
    for(auto e : graf[v]) {
        if(!ban[e[0]] && e[0] != pr && sz[e[0]] * 2 > csz)
            return find_centroid(e[0], v);
    }
    return v;
}

void insert_subtree(int v, int pr, info) {
    //insert vertex
    for(auto e : graf[v]) {
        int u = e[0];
        int d = e[1];
        if(!ban[u] && u != pr)
            insert_subtree(u, v, new info);
    }
    return ;
}

void calc_subtree(int v, int pr, info) {
    //use cur info and saved info
    for(auto e : graf[v]) {
        int u = e[0];
        int d = e[1];
        if(!ban[u] && u != pr)
            calc_subtree(u, v, new info);
    }
    return ;
}

void build(int v) {
    dfs_sz(v, 0);
    csz = sz[v];
    int c = find_centroid(v, 0);
    //centroid info
    for(auto e : graf[c]) {
        int u = e[0];
        if(!ban[u]) {
            calc_subtree(u, c, info);
            insert_subtree(u, c, info);
        }
    }
    //clear info
    ban[c] = 1;
    for(auto e : graf[c]) {
        if(!ban[e[0]])
            build(e[0]);
    }
    return ;
}
