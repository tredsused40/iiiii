struct EulerTourLCA {
    int n, timer;
    vector<int> tin, tout, depth;
    vector<vector<int>> graf;
    array<vector<int>, lg> st;

    void init(int n_) {
        n = n_;
        timer = 0;
        graf.clear();
        tin.clear();
        tout.clear();
        depth.clear();
        graf.resize(n);
        tin.resize(n);
        tout.resize(n);
        depth.resize(n, 0);
        for(int i = 0; i < lg; i++) {
            st[i].clear();
            st[i].resize(n * 2);
        }
    }

    void add_edge(int u, int v) {
        graf[u].pb(v);
        graf[v].pb(u);
    }

    void dfsorder(int v, int pr = -1) {
        tin[v] = timer;
        st[0][timer] = v;
        timer++;
        for(int u : graf[v]) {
            if(u != pr) {
                depth[u] = depth[v] + 1;
                dfsorder(u, v);
                st[0][timer] = v;
                timer++;
            }
        }
        tout[v] = timer;
    }

    inline int stget(const int &u, const int &v) {
        return depth[u] < depth[v] ? u : v;
    }

    void buildst() {
        for(int i = 1; i < lg; i++) {
            for(int j = 0; j + (1 << i) <= timer; j++) {
                int u = st[i - 1][j];
                int v = st[i - 1][j + (1 << (i - 1))];
                st[i][j] = stget(u, v);
            }
        }
    }

    int lca(int u, int v) {
        u = tin[u];
        v = tin[v];
        if(u > v)
            swap(u, v);
        int d = __lg(v - u + 1);
        return stget(st[d][u], st[d][v - (1 << d) + 1]);
    }
};
