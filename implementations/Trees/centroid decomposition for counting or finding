//1-indexed centroid decomposition
struct edge {
    int to;
    //info
};


int sz[nmax];
vector<edge> graf[nmax];
bool ban[nmax];

void dfs_sz(int v, int pr) {
    sz[v] = 1;
    for(auto e : graf[v]) {
        int u = e.to;
        if(!ban[u] && u != pr) {
            dfs_sz(u, v);
            sz[v] += sz[u];
        }
    }
}

int csz;

int find_centroid(int v, int pr) {
    for(auto e : graf[v]) {
        if(!ban[e.to] && e.to != pr && sz[e.to] * 2 > csz)
            return find_centroid(e.to, v);
    }
    return v;
}

void insert_subtree(int v, int pr, info) {
    //save vertex info
    for(auto e : graf[v]) {
        int u = e.to;
        //info
        if(!ban[u] && u != pr)
            insert_subtree(u, v, new info);
    }
}

void calc_subtree(int v, int pr, info) {
    //use cur info and saved info
    for(auto e : graf[v]) {
        int u = e.to;
        //info
        if(!ban[u] && u != pr)
            calc_subtree(u, v, new info);
    }
}

void build(int v) {
    dfs_sz(v, 0);
    csz = sz[v];
    int c = find_centroid(v, 0);
    //centroid info
    for(auto e : graf[c]) {
        int u = e.to;
        if(!ban[u]) {
            //make sure to include current edge into info
            calc_subtree(u, c, info);
            insert_subtree(u, c, info);
        }
    }
    //clear info
    ban[c] = 1;
    for(auto e : graf[c]) {
        if(!ban[e.to])
            build(e.to);
    }
}
