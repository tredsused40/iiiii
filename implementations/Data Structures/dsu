struct dsu {
    vector<int> e;

    void init(int n) {
        e.clear();
        e.resize(n + 1, -1);
    }

    int getpr(int u) {
        if(e[u] < 0)
            return u;
        return e[u] = getpr(e[u]);
    }

    bool unite(int u, int v) {
        u = getpr(u);
        v = getpr(v);
        if(u == v)
            return 0;
        if(e[u] > e[v])
            swap(u, v);
        e[u] += e[v];
        e[v] = u;
        return 1;
    }
    
    int getsz(int u) {
        return -e[getpr(u)];
    }
    
    bool is_connected(int u, int v) {
        return getpr(u) == getpr(v);
    }
};
