//1-indexed fenwick tree
//if indices are 1..n, it needs n+1 memory cells
struct FenwickTree {
    using val_type = int;
    vector<val_type> tree;
    int n;

    void init(int n_) {
        tree.clear();
        n = n_;
        tree.resize(n, 0);
    }

    val_type query(int ind) {
        val_type ans = 0;
        while(ind > 0) {
            ans += tree[ind];
            ind &= ind - 1;
        }
        return ans;
    }

    val_type query(int l, int r) {
        return query(r) - query(l - 1);
    }

    void upd(int ind, val_type val) {
        while(ind < n) {
            tree[ind] += val;
            ind += (ind & -ind);
        }
        return ;
    }
};
