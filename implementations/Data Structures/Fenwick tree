//1-indexed fenwick tree
//init(n) makes indices up to n inclusive accessible
struct FenwickTree {
    using val_type = int;
    vector<val_type> tree;
    int n;

    void init(int n_) {
        tree.clear();
        n = n_;
        tree.resize(n + 1, 0);
    }

    val_type query(int ind) {
        val_type ans = 0;
        while(ind > 0) {
            ans += tree[ind];
            ind &= ind - 1;
        }
        return ans;
    }

    val_type query(int l, int r) {
        return query(r) - query(l - 1);
    }

    void upd(int ind, val_type val) {
        while(ind <= n) {
            tree[ind] += val;
            ind += (ind & -ind);
        }
    }
};
