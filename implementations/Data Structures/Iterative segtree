struct SegTree {
    struct node {
        int mx;
        bool operator ==(const node &b) const {
            return (mx == b.mx);
        }
    };
    int n;
    vector<node> tree;
    node _0;

    void init(int n_) {//INDICES OF ELEMENTS MUST BE STRICTLY LESS THAN n
        n = n_;
        tree.clear();
        tree.resize(2 * n, _0);
        _0.mx = 0;
    }

    node createnode(const int &x) {
        node c;
        c.mx = x;
        return c;
    }

    node mymerge(node a, node b) {
        if(a == _0)
            return b;
        if(b == _0)
            return a;
        node c;
        c.mx = max(a.mx, b.mx);
        return c;
    }

    void upd(int ind, int val) {
        for(ind += n, tree[ind] = createnode(val); ind > 1; ind >>= 1)
            tree[ind >> 1] = mymerge(tree[ind], tree[ind ^ 1]);
    }

    node query(int l, int r) {//ANSWERS QUERY ON [l, r]!!!
        node res = _0;
        for(l += n, r += n + 1; l < r; l >>= 1, r >>= 1) {
            if(l & 1)
                res = mymerge(tree[l++], res);
            if(r & 1)
                res = mymerge(res, tree[--r]);
        }
        return res;
    }
};
