vector<int> pref_func(string s) {
    int n = s.size();
    vector<int> p(n, 0);
    p[0] = 0;
    for(int i = 1; i < n; i++) {
        p[i] = p[i - 1];
        while(p[i] > 0 && s[p[i]] != s[i])
            p[i] = p[p[i] - 1];
        if(s[p[i]] == s[i])
            p[i]++;
    }
    return p;
}

//z[0] = 0;
vector<int> z_func(string s) {
    int n = s.size();
    vector<int> z(n, 0);
    int l = 0;
    for(int i = 1; i < n; i++) {
        z[i] = max(0, min(l + z[l] - i, z[i - l]));
        while(z[i] + i < n && s[z[i] + i] == s[z[i]])
            z[i]++;
        if(l + z[l] < i + z[i])
            l = i;
    }
    return z;
}
