struct Dinitz {
    using flow_type = ll;
    int n, sink;
    struct edge {
        int to;
        int rev_ind;
        flow_type cap;
        flow_type flow = 0;
    };
    vector<vector<edge>> graf;
    vector<int> dist, blocked, ptr;
    void init(int nn) {
        n = nn;
        blocked.clear();
        blocked.resize(n);
        ptr.clear();
        ptr.resize(n);
        dist.clear();
        dist.resize(n);
        graf.clear();
        graf.resize(n);
    }
    void add_edge(int u, int v, flow_type cap) {
        graf[u].pb({v, graf[v].size(), cap, 0});
        graf[v].pb({u, graf[u].size() - 1, 0, 0});//change reverse edge cap to cap if undirected
    }
    void bfs(int s) {
        fill(all(dist), -1);
        dist[s] = 0;
        queue<int> q;
        q.push(s);
        while(!q.empty()) {
            int cur = q.front();
            q.pop();
            for(edge e : graf[cur]) {
                int u = e.to;
                if(dist[u] == -1 && e.flow < e.cap) {
                    dist[u] = dist[cur] + 1;
                    q.push(u);
                }
            }
        }
        return ;
    }
    flow_type dfs(int v, flow_type flow) {
        if(v == sink)
            return flow;
        while(ptr[v] < graf[v].size()) {
            edge &e = graf[v][ptr[v]];
            if(!blocked[v] && dist[v] == dist[e.to] - 1 && e.flow < e.cap) {
                flow_type cand = dfs(e.to, min(flow, e.cap - e.flow));
                if(cand) {
                    e.flow += cand;
                    graf[e.to][e.rev_ind].flow -= cand;
                    return cand;
                }
            }
            ptr[v]++;
        }
        blocked[v] = 1;
        return 0;
    }
    flow_type maxflow(int s, int t) {
        flow_type ans = 0, cur_flow;
        sink = t;
        while(1) {
            bfs(s);
            if(dist[t] == -1)
                return ans;
            cur_flow = 1;
            fill(all(blocked), 0);
            fill(all(ptr), 0);
            while(cur_flow) {
                cur_flow = dfs(s, numeric_limits<flow_type>::max());
                ans += cur_flow;
            }
        }
        return ans;
    }
};
