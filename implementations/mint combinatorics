mint fact[nmax], ifact[nmax];

mint cnk(int n, int k) {
    if(k > n || k < 0)
        return 0;
    return fact[n] * ifact[k] * ifact[n - k];
}

void initfact() {
    fact[0] = 1;
    for(int i = 1; i < nmax; i++)
        fact[i] = (fact[i - 1] * i);
    ifact[nmax - 1] = 1 / fact[nmax - 1];
    for(int i = nmax - 2; i >= 0; i--)
        ifact[i] = (ifact[i + 1] * (i + 1));
    return ;
}
