1-indexed fenwik tree

const int nmax = 1000010;
 
ll tree[nmax];
 
ll query(int ind) {
    ll ans = 0;
    while(ind > 0) {
        ans += tree[ind];
        ind &= ind - 1;
    }
    return ans;
}
 
ll query(int l, int r) {
    return query(r) - query(l - 1);
}
 
void upd(int ind, ll val, int n) {
    while(ind <= n) {
        tree[ind] += val;
        ind += (ind & -ind);
    }
    return ;
}
