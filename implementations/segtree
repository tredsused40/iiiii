int a[nmax];
 
struct node {
    int mn;
    bool operator ==(const node &b) const {
        return (mn == b.mn);
    }
};
 
node tree[nmax * 4];
node _0;
 
node createnode(const int &x) {
    node c;
    c.mn = x;
    return c;
}
 
node mymerge(node a, node b) {
    if(a == _0)
        return b;
    if(b == _0)
        return a;
    node c;
    c.mn = min(a.mn, b.mn);
    return c;
}
 
void build(int v, int l, int r) {
    if(l == r) {
        tree[v] = createnode(a[l]);
        return ;
    }
    int m = l + r >> 1;
    build(v << 1 | 1, m + 1, r);
    build(v << 1, l, m);
    tree[v] = mymerge(tree[v << 1], tree[v << 1 | 1]);
    return ;
}

void upd(int v, int l, int r, int ind, ll val) {
    if(l == r) {
        tree[v] = createnode(val);
        return ;
    }
    int m = l + r >> 1;
    if(ind <= m)
        upd(v << 1, l, m, ind, val);
    else
        upd(v << 1 | 1, m + 1, r, ind, val);
    tree[v] = mymerge(tree[v << 1], tree[v << 1 | 1]);
    return ;
}
 
node query(int v, int l, int r, int ql, int qr) {
    if(ql > qr)
        return _0;
    //cout << v << " " << l << " " << r << " " << tree[v].sum << " " << lazy[v] << "\n";
    if(l == ql && r == qr)
        return tree[v];
    int m = l + r >> 1;
    return mymerge(query(v << 1, l, m, ql, min(qr, m)), query(v << 1 | 1, m + 1, r, max(ql, m + 1), qr));
}
